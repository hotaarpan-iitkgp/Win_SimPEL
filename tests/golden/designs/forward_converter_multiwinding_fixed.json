    {
      "id": "CSCRIPT1",
      "type": "CSCRIPT",
      "x": 300.0,
      "y": 140.0,
      "rotation": 180,
      "parameters": {
        "code": "// Closed-Loop PI Voltage Controller for Forward Converter\nconst double V_ref = 12.0;\nconst double Kp = 0.25;\nconst double Ki = 120.0;\nconst double fc = 50000.0;\nconst double dt = 1e-6;\nconst double D_max = 0.45;\nconst double D_min = 0.01;\n\ndouble integrator = 0.0;\ndouble ramp = 0.0;\n\nvoid step() {\n    double v_target = inputs[0];\n    double v_actual = inputs[1];\n    double error = v_target - v_actual;\n    double P = Kp * error;\n    double next_integrator = integrator + Ki * error * dt;\n    double duty = P + next_integrator;\n\n    if (duty > D_max) {\n        duty = D_max;\n        if (error < 0.0) integrator = next_integrator;\n    } else if (duty < D_min) {\n        duty = D_min;\n        if (error > 0.0) integrator = next_integrator;\n    } else {\n        integrator = next_integrator;\n    }\n\n    double next_ramp = ramp + fc * dt;\n    ramp = (next_ramp >= 1.0) ? next_ramp - 1.0 : next_ramp;\n    double gate = (ramp < duty) ? 1.0 : 0.0;\n    outputs[0] = gate;\n}"
      }
    },
