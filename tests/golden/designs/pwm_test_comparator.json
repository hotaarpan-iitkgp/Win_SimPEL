{
  "components": [
    {
      "id": "SINE1",
      "type": "SINE_WAVE",
      "x": 100,
      "y": 200,
      "rotation": 0,
      "parameters": { "amplitude": "1", "frequency": "50", "phase": "0", "bias": "0" },
      "label": "50Hz Sine Reference"
    },
    {
      "id": "TRI1",
      "type": "TRI_GEN",
      "x": 100,
      "y": 300,
      "rotation": 0,
      "parameters": { "frequency": "1k", "min": "-1", "max": "1" },
      "label": "1kHz Triangle Carrier"
    },
    {
      "id": "COMP1",
      "type": "COMP",
      "x": 300,
      "y": 250,
      "rotation": 0,
      "parameters": { "hysteresis": "0" },
      "label": "PWM Comparator"
    },
    {
      "id": "SCOPE1",
      "type": "SCOPE",
      "x": 500,
      "y": 250,
      "rotation": 0,
      "parameters": { "channels": "3" },
      "label": "Output Scope"
    }
  ],
  "wires": [
    {
      "id": "w1",
      "from": { "type": "pin", "compId": "SINE1", "terminal": "Out" },
      "to": { "type": "pin", "compId": "COMP1", "terminal": "Plus" }
    },
    {
      "id": "w2",
      "from": { "type": "pin", "compId": "TRI1", "terminal": "Out" },
      "to": { "type": "pin", "compId": "COMP1", "terminal": "Minus" }
    },
    {
      "id": "w3",
      "from": { "type": "pin", "compId": "SINE1", "terminal": "Out" },
      "to": { "type": "pin", "compId": "SCOPE1", "terminal": "In1" }
    },
    {
      "id": "w4",
      "from": { "type": "pin", "compId": "TRI1", "terminal": "Out" },
      "to": { "type": "pin", "compId": "SCOPE1", "terminal": "In2" }
    },
    {
      "id": "w5",
      "from": { "type": "pin", "compId": "COMP1", "terminal": "Out" },
      "to": { "type": "pin", "compId": "SCOPE1", "terminal": "In3" }
    }
  ],
  "plotConfiguration": {
    "plots": [
      {
        "title": "Reference vs Carrier",
        "variables": [ "SINE1.Out", "TRI1.Out" ]
      },
      {
        "title": "PWM Output",
        "variables": [ "COMP1.Out" ]
      }
    ]
  },
  "simulationSettings": {
    "stopTime": "0.04",
    "stepSize": "10u",
    "solver": "euler",
    "stepType": "fixed"
  }
}
