    {
      "id": "CSCRIPT1",
      "type": "CSCRIPT",
      "x": -440,
      "y": -280,
      "rotation": 0,
      "parameters": {
        "timestep": "0",
        "plot_custom_vars": "",
        "code": "// ─── THREE-PHASE SPWM CONTROLLER ───\nconst double M = 0.85;        // Modulation index (0.0 to 1.0)\nconst double fm = 50.0;       // Fundamental frequency (Hz)\nconst double fc = 5000.0;     // Carrier frequency (Hz)\nconst double dt = 1e-6;       // Time step\n\n// ─── State Variables ───\ndouble ramp = 0.0;\n\nvoid step() {\n    // Triangular carrier (-1.0 to +1.0)\n    double next_ramp = ramp + fc * dt;\n    ramp = (next_ramp >= 1.0) ? next_ramp - 1.0 : next_ramp;\n    double v_car = (ramp < 0.5) ? (4.0 * ramp - 1.0) : (3.0 - 4.0 * ramp);\n\n    // 120-degree phase shifts\n    double phase_B_offset = 2.0 * PI / 3.0;\n    double phase_C_offset = 4.0 * PI / 3.0;\n\n    // Reference sinusoidal signals\n    double v_refA = M * sin(2.0 * PI * fm * time);\n    double v_refB = M * sin(2.0 * PI * fm * time - phase_B_offset);\n    double v_refC = M * sin(2.0 * PI * fm * time - phase_C_offset);\n\n    // Leg A Gate Signals\n    outputs[0] = (v_refA > v_car) ? 1.0 : 0.0; // Phase A Top Gate (MOSFET1)\n    outputs[1] = (outputs[0] > 0.5) ? 0.0 : 1.0; // Phase A Bottom Gate (MOSFET2)\n\n    // Leg B Gate Signals\n    outputs[2] = (v_refB > v_car) ? 1.0 : 0.0; // Phase B Top Gate (MOSFET3)\n    outputs[3] = (outputs[2] > 0.5) ? 0.0 : 1.0; // Phase B Bottom Gate (MOSFET4)\n\n    // Leg C Gate Signals\n    outputs[4] = (v_refC > v_car) ? 1.0 : 0.0; // Phase C Top Gate (MOSFET5)\n    outputs[5] = (outputs[4] > 0.5) ? 0.0 : 1.0; // Phase C Bottom Gate (MOSFET6)\n}",
        "M": "0.85",
        "fm": "50.0",
        "fc": "5000.0",
        "dt": "1e-6"
      }
    }
