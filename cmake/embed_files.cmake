# Embeds text files into a C++ source as byte arrays.
# Usage: cmake -DOUT=<file.cpp> -DSYMBOL=<name> -DFILES="a.json;b.json" -P embed_files.cmake
# Produces:
#   namespace simpel_embedded { struct EmbeddedFile { const char* name; const unsigned char* data; unsigned long size; };
#   extern const EmbeddedFile <SYMBOL>[]; extern const unsigned long <SYMBOL>_count; }
# Byte arrays rather than string literals: MSVC limits string literals to ~16 KB.
set(out "// Generated by cmake/embed_files.cmake. Do not edit.\n#include \"engine/EmbeddedFiles.hpp\"\nnamespace simpel_embedded {\n")
set(table "")
set(i 0)
list(SORT FILES)
foreach(f IN LISTS FILES)
    file(READ "${f}" hex HEX)
    file(SIZE "${f}" sz)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # Line-wrap every 32 bytes to keep the generated file readable by tools.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" hex "${hex}")
    get_filename_component(fname "${f}" NAME)
    string(APPEND out "static const unsigned char ${SYMBOL}_${i}[] = {\n${hex}0x00};\n")
    string(APPEND table "    {\"${fname}\", ${SYMBOL}_${i}, ${sz}ul},\n")
    math(EXPR i "${i}+1")
endforeach()
string(APPEND out "extern const EmbeddedFile ${SYMBOL}[] = {\n${table}    {nullptr, nullptr, 0ul}\n};\n")
string(APPEND out "extern const unsigned long ${SYMBOL}_count = ${i}ul;\n} // namespace simpel_embedded\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL out)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${out}")
