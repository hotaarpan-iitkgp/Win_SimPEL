# Generates a name <-> value table for CircuitSim::ComponentType from its declaration
# in Components.hpp, so the block registry can refer to enum values by name without
# a hand-maintained list that could drift.
# Usage: cmake -DIN=<Components.hpp> -DOUT=<ComponentTypeNames.inc> -P gen_component_type_names.cmake
file(READ "${IN}" src)
string(FIND "${src}" "enum class ComponentType {" start)
if(start EQUAL -1)
    message(FATAL_ERROR "enum class ComponentType not found in ${IN}")
endif()
string(SUBSTRING "${src}" ${start} -1 rest)
string(FIND "${rest}" "};" stop)
string(SUBSTRING "${rest}" 0 ${stop} body)
string(REPLACE "enum class ComponentType {" "" body "${body}")
# Strip // comments (to end of line) and /* */ comments.
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" body "${body}")
string(REGEX REPLACE "//[^\n]*" "" body "${body}")
string(REGEX REPLACE "[ \t\r\n]+" "" body "${body}")
string(REPLACE "," ";" names "${body}")
set(out "// Generated from Components.hpp by cmake/gen_component_type_names.cmake. Do not edit.\n")
set(n 0)
foreach(name IN LISTS names)
    if(name STREQUAL "")
        continue()
    endif()
    if(name MATCHES "=")
        message(FATAL_ERROR "ComponentType enumerators with explicit values are not supported: ${name}")
    endif()
    string(APPEND out "{\"${name}\", ComponentType::${name}},\n")
    math(EXPR n "${n}+1")
endforeach()
# Only rewrite when the content changes, so dependents are not rebuilt needlessly.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL out)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${out}")
message(STATUS "ComponentType names: ${n} enumerators")
